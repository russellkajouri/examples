  0 impropers with max type 0
    fix             ensemble all rigid/nvt/small molecule temp 300.0 300.0 $(dt*100)  mol mols
    fix             ensemble all rigid/nvt/small molecule temp 300.0 300.0 25  mol mols
Fix rigid/nvt/small setup ...
  create bodies CPU = 0.000 seconds
  350 rigid bodies with 1050 atoms
  1.54 = max distance from body owner to body atom
    fix_modify      ensemble dynamic/dof yes


    ## GCMC setup
    variable        co2tfac equal 5.0/3.0
    fix             co2gcmc co2 gcmc ${MDsteps} ${MCsteps} 0 0 ${seed1} ${temp} ${co2mu} 0.1                     mol mols group mobile tfac_insert ${co2tfac} rigid ensemble full_energy
    fix             co2gcmc co2 gcmc 400 ${MCsteps} 0 0 ${seed1} ${temp} ${co2mu} 0.1                     mol mols group mobile tfac_insert ${co2tfac} rigid ensemble full_energy
    fix             co2gcmc co2 gcmc 400 100 0 0 ${seed1} ${temp} ${co2mu} 0.1                     mol mols group mobile tfac_insert ${co2tfac} rigid ensemble full_energy
    fix             co2gcmc co2 gcmc 400 100 0 0 12442 ${temp} ${co2mu} 0.1                     mol mols group mobile tfac_insert ${co2tfac} rigid ensemble full_energy
    fix             co2gcmc co2 gcmc 400 100 0 0 12442 300.0 ${co2mu} 0.1                     mol mols group mobile tfac_insert ${co2tfac} rigid ensemble full_energy
    fix             co2gcmc co2 gcmc 400 100 0 0 12442 300.0 -8.30 0.1                     mol mols group mobile tfac_insert ${co2tfac} rigid ensemble full_energy
    fix             co2gcmc co2 gcmc 400 100 0 0 12442 300.0 -8.30 0.1                     mol mols group mobile tfac_insert 1.66666666666667 rigid ensemble full_energy

    #fix             acngcmc acn gcmc ${MDsteps} ${MCsteps} 0 0 ${seed2} ${temp} ${acnmu} 0.1     #                mol mols group mobile tfac_insert ${co2tfac} rigid ensemble full_energy



    thermo          1000
    thermo_style    custom step temp c_mdtemp press etotal ke pe v_nacn v_nco2
    compute_modify  thermo_temp dynamic/dof yes

    variable        mtemp  equal temp
    variable        mpress equal press
    variable        mke    equal ke
    variable        mpe    equal pe
    variable        metot  equal etotal


    fix             nvtstat all ave/time 250 20  10000 v_mtemp c_mdtemp v_mpress v_mke v_mpe v_metot file thermal_statistics.dat

    variable        ciatt equal f_co2gcmc[3]
    variable        ciacc equal f_co2gcmc[4]
    variable        cdatt equal f_co2gcmc[5]
    variable        cdacc equal f_co2gcmc[6]

    fix             cgcmcstat all ave/time ${MDsteps} 1 ${MDsteps} v_ciatt v_ciacc v_cdatt v_cdacc v_nco2 v_nmob file co2_stats.dat
    fix             cgcmcstat all ave/time 400 1 ${MDsteps} v_ciatt v_ciacc v_cdatt v_cdacc v_nco2 v_nmob file co2_stats.dat
    fix             cgcmcstat all ave/time 400 1 400 v_ciatt v_ciacc v_cdatt v_cdacc v_nco2 v_nmob file co2_stats.dat

    #variable        wiatt equal f_acngcmc[3]
    #variable        wiacc equal f_acngcmc[4]
    #variable        wdatt equal f_acngcmc[5]
    #variable        wdacc equal f_acngcmc[6]

    #fix             agcmcstat all ave/time ${MDsteps} 1 ${MDsteps} v_wiatt v_wiacc v_wdatt v_wdacc v_nacn v_nmob file acn_stats.dat

    dump            mdump all custom ${MDsteps} traj.lammpstrj id mol type xu yu zu #
    dump            mdump all custom 400 traj.lammpstrj id mol type xu yu zu 
    dump_modify     mdump flush yes

    restart         ${MDsteps} system.cpt system.cpt
    restart         400 system.cpt system.cpt

    run             ${runsteps} upto
    run             1000000 upto
